# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# SQLite local databases — never commit these
dev.db
*.db
*.db-journal
*.db-shm
*.db-wal

# debug & build logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
build_log*.txt
clean-build*.log
verify_*.txt

# temporary & binary test artifacts
dummy.bin
test.mp4
test-prisma.js
check-lucas-user.js

# env files — ignore all except the example template
.env*
!.env.example
instructions.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
