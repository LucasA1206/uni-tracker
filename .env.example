# ==========================================
# UniTracker Environment Variables Example
# Duplicate this file to .env and .env.local
# NEVER commit real API keys or passwords!
# ==========================================

# ── Database ─────────────────────────────
# Local development (SQLite): file:./dev.db
# Production (PostgreSQL connection pool URL):
DATABASE_URL="file:./dev.db"
POSTGRES_PRISMA_URL="postgresql://user:password@host:port/database?sslmode=require"
STORAGE_POSTGRES_URL="postgresql://user:password@host:port/database"

# ── Authentication ───────────────────────
# Strong, unguessable secret used to sign user session JWTs (at least 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET="your-32-character-or-longer-random-jwt-secret-here"

# ── Google Gemini AI ─────────────────────
# API key for AI note generation and quizzes (from Google AI Studio)
GEMINI_API_KEY="your-gemini-api-key"

# ── Canvas LMS Integration ───────────────
# Canvas institution base URL (e.g. https://canvas.uts.edu.au)
CANVAS_BASE_URL="https://canvas.example.edu"
CANVAS_API_TOKEN1="your-canvas-access-token"

# ── Google OAuth (Gmail & Google Calendar) 
GMAIL_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="your-google-client-secret"
GMAIL_REDIRECT_URI="http://localhost:3000/api/integrations/gmail/callback"

# ── Microsoft Graph OAuth ────────────────
MS_CLIENT_ID="your-microsoft-app-client-id"
MS_CLIENT_SECRET="your-microsoft-app-client-secret"
MS_REDIRECT_URI="http://localhost:3000/api/integrations/microsoft/callback"
MS_TENANT_ID="common"
